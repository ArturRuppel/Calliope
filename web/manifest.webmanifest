{
  "name": "Calliope",
  "short_name": "Calliope",
  "description": "Slide decks drawn and presented in the browser, with nothing to install",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f3f3f4",
  "theme_color": "#f3f3f4",
  "icons": [
    { "src": "editor/icon.svg", "sizes": "any", "type": "image/svg+xml" },
    { "src": "editor/apple-touch-icon.png", "sizes": "180x180", "type": "image/png" }
  ]
}
