[Unit]
Description=svgdeck slide editor and presenter
Documentation=file:%h/Projects/svgdeck/README.md
After=network.target

[Service]
# Binds the tailnet address only (like labbook.service): the editor can change
# decks, so it is reachable from the iPad/phone over Tailscale and from nowhere
# else. Restart retries while Tailscale is still coming up after boot.
# Data (decks, fonts) lives in ~/Data/svgdeck, outside the repo.
ExecStart=/bin/sh -c 'exec %h/Projects/svgdeck/.venv/bin/svgdeck serve --data %h/Data/svgdeck --host "$(tailscale ip -4)" --port 8490'
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
