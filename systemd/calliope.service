[Unit]
Description=Calliope — slide editor and presenter
Documentation=file:%h/Projects/Calliope/README.md
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
# Binds loopback only; Tailscale Serve publishes it to the tailnet as
# https://<machine>.<tailnet>.ts.net:8490 (set up once with
# `tailscale serve --bg --https=8490 http://127.0.0.1:8490`). HTTPS is what lets
# the iPad keep an offline copy: service workers need a secure context.
# Data (decks, fonts) lives in ~/Data/svgdeck, outside the repo.
ExecStart=%h/Projects/Calliope/.venv/bin/svgdeck serve --data %h/Data/svgdeck --host 127.0.0.1 --port 8490
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
